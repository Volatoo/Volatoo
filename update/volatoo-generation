def main() -> int:
    arguments = parse_arguments()
    try:
        if arguments.command == "publish":
            if (
                arguments.activate
                and arguments.expected_current is EXPECTED_CURRENT_UNSET
            ):
                raise GenerationError(
                    "--activate requires --expected-current DIGEST|none"
                )
            if (
                not arguments.activate
                and arguments.expected_current is not EXPECTED_CURRENT_UNSET
            ):
                raise GenerationError(
                    "--expected-current requires --activate"
                )
        if (
            arguments.command == "select"
            and arguments.expected_current is EXPECTED_CURRENT_UNSET
        ):
            raise GenerationError(
                "select requires --expected-current DIGEST|none"
            )
        if arguments.command == "select":
            if arguments.require_signature and not arguments.trusted_key:
                raise GenerationError(
                    "--require-signature requires at least one --trusted-key"
                )
            if arguments.trusted_key and not arguments.require_signature:
                raise GenerationError(
                    "--trusted-key requires --require-signature"
                )
        if arguments.command == "record-realization":
            if (
                arguments.activate
                and arguments.expected_current is EXPECTED_CURRENT_UNSET
            ):
                raise GenerationError(
                    "--activate requires --expected-current DIGEST|none"
                )
            if (
                not arguments.activate
                and arguments.expected_current is not EXPECTED_CURRENT_UNSET
            ):
                raise GenerationError(
                    "--expected-current requires --activate"
                )
        if arguments.command == "sign-realization":
            if (
                arguments.activate
                and arguments.expected_current is EXPECTED_CURRENT_UNSET
            ):
                raise GenerationError(
                    "--activate requires --expected-current DIGEST|none"
                )
            if (
                not arguments.activate
                and arguments.expected_current is not EXPECTED_CURRENT_UNSET
            ):
                raise GenerationError(
                    "--expected-current requires --activate"
                )
        if (
            arguments.command == "scrub"
            and arguments.require_signature
            and not arguments.trusted_key
        ):
            raise GenerationError(
                "--require-signature requires at least one --trusted-key"
            )
        if arguments.command == "compact-manifest":
            if (arguments.receipt is None) != (arguments.tree_digest is None):
                raise GenerationError(
                    "--receipt and --tree-digest must be provided together"
                )
        arguments.handler(arguments)
    except GenerationError as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
