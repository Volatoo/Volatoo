{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volatoo.org/schemas/portage-engine-target-v1.schema.json",
  "title": "Volatoo Portage Engine target binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target_id",
    "build_context_digest",
    "engine"
  ],
  "properties": {
    "schema": {
      "const": "org.volatoo.portage-engine-target/v1"
    },
    "target_id": {
      "type": "string"
    },
    "build_context_digest": {
      "$ref": "#/$defs/digest"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "arch",
        "repository_ids",
        "repository_names",
        "resource_class",
        "image_digest",
        "mirror_bundle_digest",
        "binhost_path",
        "required_features"
      ],
      "properties": {
        "profile_id": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "repository_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "repository_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "resource_class": {
          "type": "string"
        },
        "image_digest": {
          "$ref": "#/$defs/digest"
        },
        "mirror_bundle_digest": {
          "$ref": "#/$defs/digest"
        },
        "binhost_path": {
          "type": "string",
          "pattern": "^/binpkgs/volatoo/"
        },
        "required_features": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
