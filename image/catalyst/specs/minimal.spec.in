# Rendered by scripts/build-catalyst-squashfs.sh.
subarch: amd64
target: stage4
version_stamp: @VERSION@
rel_type: @REL_TYPE@
profile: @PROFILE@
snapshot_treeish: @SNAPSHOT@
source_subpath: @REL_TYPE@/@SOURCE@

# The dedicated builder extends pyDeComp's compressor map to create a
# 1 MiB-block SquashFS with Zstd at the measured Volatoo level 19.
compression_mode: squashfs_zstd
decompressor_search_order: pixz lbzip2 squashfs gzip xz bzip2 tar

stage4/packages:
@PACKAGES@

stage4/root_overlay: /config/overlay
stage4/fsscript: /config/finalize.sh
@INIT_SETTINGS@
stage4/empty: /var/cache/binpkgs /var/cache/distfiles /var/tmp/portage
