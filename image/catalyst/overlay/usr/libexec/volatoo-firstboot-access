#!/bin/sh

set -eu

root=${VOLATOO_ROOT:-}
state_root=${VOLATOO_STATE_ROOT:-${root}/.volatoo/state}
config_dir=$state_root/volatoo/config
access_dir=$config_dir/access
authorized_keys=$access_dir/authorized_keys

if [ ! -e "$authorized_keys" ]; then
	echo "[volatoo] no administrator SSH key is provisioned"
	exit 0
fi
if [ -L "$config_dir" ] || [ -L "$access_dir" ] || [ -L "$authorized_keys" ] ||
	[ ! -d "$config_dir" ] || [ ! -d "$access_dir" ] || [ ! -f "$authorized_keys" ]; then
	echo "error: unsafe administrator access configuration" >&2
	exit 1
fi
if [ ! -s "$authorized_keys" ]; then
	echo "error: administrator authorized_keys is empty" >&2
	exit 1
fi

if ! awk '
	NF == 0 || $1 ~ /^#/ { next }
	$1 !~ /^(ssh-ed25519|sk-ssh-ed25519@openssh.com|ecdsa-sha2-nistp(256|384|521)|sk-ecdsa-sha2-nistp256@openssh.com|ssh-rsa)$/ { exit 1 }
	$2 !~ /^[A-Za-z0-9+\/=]+$/ { exit 1 }
	{ keys++ }
	END { if (keys == 0) exit 1 }
' "$authorized_keys"; then
	echo "error: administrator authorized_keys is invalid" >&2
	exit 1
fi

passwd_file=${root}/etc/passwd
if ! awk -F: '$1 == "volatoo" { found++ } END { exit found == 1 ? 0 : 1 }' "$passwd_file"; then
	if [ -n "$root" ]; then
		useradd --root "$root" --create-home --user-group --shell /bin/bash volatoo
	else
		useradd --create-home --user-group --shell /bin/bash volatoo
	fi
fi
if [ -n "$root" ]; then
	usermod --root "$root" --append --groups wheel --password x volatoo
else
	usermod --append --groups wheel --password x volatoo
fi

uid=$(awk -F: '$1 == "volatoo" { print $3 }' "$passwd_file")
gid=$(awk -F: '$1 == "volatoo" { print $4 }' "$passwd_file")
case $uid:$gid in
	*[!0-9:]*|:*|*:)
		echo "error: invalid volatoo account identity" >&2
		exit 1
		;;
esac

home=${root}/home/volatoo
ssh_dir=$home/.ssh
if [ -L "$home" ] || [ -L "$ssh_dir" ] || [ -L "$ssh_dir/authorized_keys" ]; then
	echo "error: unsafe volatoo home SSH path" >&2
	exit 1
fi
install -d -m 0700 "$ssh_dir"
install -m 0600 "$authorized_keys" "$ssh_dir/authorized_keys"
chown -R "$uid:$gid" "$ssh_dir"

install -d -m 0750 "${root}/etc/sudoers.d"
printf '%s\n' 'volatoo ALL=(ALL:ALL) NOPASSWD: ALL' \
	>"${root}/etc/sudoers.d/90-volatoo"
chmod 0440 "${root}/etc/sudoers.d/90-volatoo"

install -d -m 0755 "${root}/etc/ssh/sshd_config.d"
cat >"${root}/etc/ssh/sshd_config.d/20-volatoo-access.conf" <<'EOF'
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
PubkeyAuthentication yes
EOF
chmod 0644 "${root}/etc/ssh/sshd_config.d/20-volatoo-access.conf"

echo "[volatoo] administrator SSH access ready"
