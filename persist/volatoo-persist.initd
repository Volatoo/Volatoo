#!/sbin/openrc-run
# shellcheck shell=sh
# shellcheck disable=SC2034

description="Synchronize Volatoo state before local filesystems are unmounted"

depend()
{
	need localmount
}

start()
{
	if [ ! -f /.volatoo/state/volatoo/layout-version ]; then
		einfo "Volatoo state is unavailable; persistence sync is disabled"
		return 0
	fi
	if [ ! -f /.volatoo/image-id ]; then
		einfo "No sync policies are configured"
		return 0
	fi

	einfo "Volatoo persistence sync is enabled"
}

stop()
{
	if [ ! -f /.volatoo/state/volatoo/layout-version ]; then
		einfo "Volatoo state is unavailable; skipping persistence sync"
		return 0
	fi
	if [ ! -f /.volatoo/image-id ]; then
		einfo "No sync policies are configured; skipping persistence sync"
		return 0
	fi

	ebegin "Synchronizing Volatoo state"
	/usr/sbin/volatoo-persist sync
	eend $? "Volatoo persistence sync failed"
}
