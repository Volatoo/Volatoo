#!/bin/sh

# Volatoo early userspace. Keep this script compatible with BusyBox ash.

PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH

echo "[volatoo] initramfs started"

rescue_shell() {
	echo
	echo "=== Volatoo boot failure ==="
	echo "code: $failure_code"
	echo "message: $failure_message"
	echo
	echo "=== Boot state ==="
	echo "kernel: $(uname -srmo 2>/dev/null || echo unavailable)"
	echo "command line: $(cat /proc/cmdline 2>/dev/null || echo unavailable)"
	echo "image spec: ${image_spec:-unset}"
	echo "image file: ${image_file:-none}"
	echo "resolved device: ${image_device:-unresolved}"
	echo "loop device: ${loop_device:-none}"
	echo "expected sha256: ${image_sha256:-not configured}"
	echo "actual sha256: ${actual_image_sha256:-not computed}"
	echo "RAM image sha256: ${ram_image_sha256:-not computed}"
	echo "root mode: ${root_mode:-unset}"
	echo "target init: ${target_init:-unset}"
	echo "tmpfs size: ${tmpfs_size:-unset}"
	echo "state spec: ${state_spec:-unset}"
	echo "state required: ${state_required:-unset}"
	echo "state device: ${state_device:-not found}"
	echo "state mounted: ${state_mounted:-0}"
	echo "system store read-only: ${system_store_readonly:-0}"
	echo "system layout: ${system_layout_version:-none}"
	echo "generation mode: ${generation_mode:-unset}"
	echo "signature policy: ${signature_policy:-unset}"
	echo "release signature verified: ${generation_signature_verified:-0}"
	echo "signature key: ${generation_signature_key_id:-none}"
	echo "generation selected: ${generation_digest:-legacy image}"
	echo "generation realized: ${generation_realized:-0}"
	echo "realization: ${generation_realization_digest:-none}"
	echo "realization contract: ${generation_realization_version:-none}"
	echo "dm-verity: ${generation_verity:-0}"
	echo "FHS contract: ${generation_fhs_contract:-none}"
	echo "generation error: ${generation_error:-none}"
	echo
	echo "=== Block devices and filesystems ==="
	if ! cat /proc/partitions 2>/dev/null; then
		echo "/proc/partitions is unavailable"
	fi
	echo
	echo "blkid:"
	blkid 2>/dev/null || true
	echo
	echo "=== Current mounts ==="
	if ! cat /proc/mounts 2>/dev/null; then
		echo "/proc/mounts is unavailable"
	fi
	echo
	echo "=== Rescue shell ==="
	echo "Useful commands:"
	echo "  blkid"
	echo "  ls -l /dev"
	echo "  cat /proc/partitions"
	echo "  cat /proc/cmdline"
	echo "  cat /proc/mounts"
	echo "  dmesg | tail"
	echo "  poweroff -f"
	echo

	PS1='volatoo-rescue# '
	export PS1
	if [ -c /dev/console ]; then
		while true; do
			setsid -c sh </dev/console >/dev/console 2>&1
			echo "[volatoo] rescue shell exited; restarting it" >/dev/console
		done
	fi
	exec sh
}

fatal() {
	failure_code=$1
	failure_message=$2
	rescue_shell
}

load_module() {
	module=$1

	# A development base initramfs may provide kmod with support for compressed
	# modules. Prefer it when its executable is present, but do not resolve the
	# fallback through PATH: some base initramfs images retain a broken
	# /sbin/modprobe -> ../bin/kmod link after pruning kmod itself.
	if [ -x /sbin/modprobe ]; then
		/sbin/modprobe "$module" 2>/dev/null || true
	elif [ -x /bin/busybox ]; then
		/bin/busybox modprobe "$module" 2>/dev/null || true
	fi
}

protect_system_store() {
	state_root=$1
	system_path=$state_root/volatoo/system
	if [ ! -e "$system_path" ] && [ ! -L "$system_path" ]; then
		return
	fi
	if [ -L "$system_path" ] || [ ! -d "$system_path" ]; then
		fatal state.system-store \
			"system store is not a safe directory"
	fi
	if ! mount --bind "$system_path" "$system_path"; then
		fatal state.system-store \
			"could not create the system-store protection mount"
	fi
	if ! mount -o remount,bind,ro "$system_path"; then
		umount "$system_path" 2>/dev/null || true
		fatal state.system-store \
			"could not make the public system store read-only"
	fi
	system_store_readonly=1
	echo "[volatoo] public system store mounted read-only"
}

resolve_device_spec() {
	device_spec=$1

	case $device_spec in
		LABEL=*)
			metadata_key=LABEL
			metadata_value=${device_spec#LABEL=}
			;;
		UUID=*)
			metadata_key=UUID
			metadata_value=${device_spec#UUID=}
			;;
		*)
			printf '%s\n' "$device_spec"
			return
			;;
	esac

	# BusyBox blkid does not implement util-linux's -L/-U lookup flags. Scan
	# all currently visible filesystems and match the quoted metadata value.
	blkid 2>/dev/null |
		while IFS= read -r metadata; do
			case $metadata in
				*"$metadata_key=\"$metadata_value\""*)
					printf '%s\n' "${metadata%%:*}"
					;;
			esac
		done
}

verify_image_integrity() {
	integrity_source=$1

	if [ -z "$image_sha256" ]; then
		echo "[volatoo] warning: no SHA-256 configured; image integrity is unchecked"
		return
	fi

	echo "[volatoo] verifying SHA-256: $integrity_source"
	verify_started=$(date +%s)
	if ! checksum_output=$(sha256sum "$integrity_source" 2>/dev/null); then
		fatal image.hash-read \
			"could not calculate SHA-256 for: $integrity_source"
	fi
	actual_image_sha256=${checksum_output%% *}
	verify_finished=$(date +%s)

	if [ "$actual_image_sha256" != "$image_sha256" ]; then
		fatal image.integrity \
			"SHA-256 mismatch for: $integrity_source"
	fi
	echo "[volatoo] SHA-256 verified in $((verify_finished - verify_started))s"
}

parse_persist_config_line() {
	persist_config_line=$1
	persist_config_line_number=$2
	persist_policy=
	persist_target=
	persist_key=

	if [ "${#persist_config_line}" -gt 512 ]; then
		fatal persist.config \
			"line $persist_config_line_number exceeds 512 characters"
	fi

	set -f
	# Intentional field splitting implements the whitespace-delimited grammar.
	# Globbing remains disabled so state-controlled input cannot expand paths.
	# shellcheck disable=SC2086
	set -- $persist_config_line
	set +f

	if [ "$#" -eq 0 ]; then
		return
	fi
	case $1 in
		\#*) return ;;
	esac
	if [ "$#" -ne 3 ]; then
		fatal persist.config \
			"line $persist_config_line_number must contain: policy target key"
	fi

	persist_policy=$1
	persist_target=$2
	persist_key=$3

	case $persist_policy in
		bind | overlay | sync) ;;
		*)
			fatal persist.config \
				"line $persist_config_line_number has an unsupported policy: $persist_policy"
			;;
	esac

	case $persist_target in
		/*) ;;
		*)
			fatal persist.config \
				"line $persist_config_line_number target must be absolute: $persist_target"
			;;
	esac
	if [ "$persist_target" = / ] || \
		[ "${persist_target%/}" != "$persist_target" ] || \
		[ "${#persist_target}" -gt 255 ]; then
		fatal persist.config \
			"line $persist_config_line_number has an invalid target: $persist_target"
	fi
	case "/${persist_target#/}/" in
		*/../* | */./* | *//*)
			fatal persist.config \
				"line $persist_config_line_number target is not normalized: $persist_target"
			;;
	esac
	case $persist_target in
		*[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_./+@:-]*)
			fatal persist.config \
				"line $persist_config_line_number target contains unsupported characters"
			;;
	esac
	case "$persist_target/" in
		/dev/* | /proc/* | /run/* | /sys/* | /.volatoo/*)
			fatal persist.config \
				"line $persist_config_line_number targets a protected early-boot path: $persist_target"
			;;
	esac

	if [ "${#persist_key}" -gt 64 ]; then
		fatal persist.config \
			"line $persist_config_line_number key exceeds 64 characters"
	fi
	case $persist_key in
		'' | *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-]*)
			fatal persist.config \
				"line $persist_config_line_number has an invalid storage key: $persist_key"
			;;
	esac
}

validate_persist_config() {
	persist_config_path=$1
	persist_config_line_number=0
	persist_policy_count=0
	persist_sync_configured=0
	persist_seen_targets=
	persist_seen_keys=

	while IFS= read -r persist_config_line || [ -n "$persist_config_line" ]; do
		persist_config_line_number=$((persist_config_line_number + 1))
		parse_persist_config_line \
			"$persist_config_line" "$persist_config_line_number"
		if [ -z "$persist_policy" ]; then
			continue
		fi

		persist_policy_count=$((persist_policy_count + 1))
		if [ "$persist_policy_count" -gt 64 ]; then
			fatal persist.config "configuration exceeds 64 policies"
		fi
		if [ "$persist_policy" = sync ]; then
			persist_sync_configured=1
		fi

		for existing_target in $persist_seen_targets; do
			case "$persist_target/" in
				"$existing_target/"*)
					fatal persist.config \
						"line $persist_config_line_number target overlaps: $persist_target and $existing_target"
					;;
			esac
			case "$existing_target/" in
				"$persist_target/"*)
					fatal persist.config \
						"line $persist_config_line_number target overlaps: $persist_target and $existing_target"
					;;
			esac
		done

		persist_key_token=$persist_policy:$persist_key
		for existing_key in $persist_seen_keys; do
			if [ "$persist_key_token" = "$existing_key" ]; then
				fatal persist.config \
					"line $persist_config_line_number duplicates storage key: $persist_key_token"
			fi
		done

		if [ ! -d "/newroot$persist_target" ] || \
			[ -L "/newroot$persist_target" ]; then
			fatal persist.target \
				"line $persist_config_line_number target must be an existing directory: $persist_target"
		fi

		persist_policy_base=/state/volatoo/data/$persist_policy/$persist_key
		if [ -L "$persist_policy_base" ] || \
			{ [ -e "$persist_policy_base" ] && [ ! -d "$persist_policy_base" ]; }; then
			fatal persist.state-path \
				"line $persist_config_line_number storage key is not a safe directory: $persist_key"
		fi
		case $persist_policy in
			bind)
				if [ -L "$persist_policy_base/root" ] || \
					{ [ -e "$persist_policy_base/root" ] && [ ! -d "$persist_policy_base/root" ]; } || \
					[ -L "$persist_policy_base/initialized" ] || \
					{ [ -e "$persist_policy_base/initialized" ] && [ ! -f "$persist_policy_base/initialized" ]; }; then
					fatal persist.state-path \
						"line $persist_config_line_number bind storage is unsafe: $persist_key"
				fi
				;;
				overlay)
					for overlay_directory in upper work; do
					if [ -L "$persist_policy_base/$overlay_directory" ] || \
						{ [ -e "$persist_policy_base/$overlay_directory" ] && \
							[ ! -d "$persist_policy_base/$overlay_directory" ]; }; then
						fatal persist.state-path \
							"line $persist_config_line_number overlay storage is unsafe: $persist_key"
					fi
					done
					;;
				sync)
					for sync_directory in bases generations; do
						if [ -L "$persist_policy_base/$sync_directory" ] || \
							{ [ -e "$persist_policy_base/$sync_directory" ] && \
								[ ! -d "$persist_policy_base/$sync_directory" ]; }; then
							fatal persist.state-path \
								"line $persist_config_line_number sync storage is unsafe: $persist_key"
						fi
					done
					if [ -L "$persist_policy_base/current" ] || \
						{ [ -e "$persist_policy_base/current" ] && \
							[ ! -f "$persist_policy_base/current" ]; }; then
						fatal persist.state-path \
							"line $persist_config_line_number sync pointer is unsafe: $persist_key"
					fi
					;;
			esac

		persist_seen_targets="$persist_seen_targets $persist_target"
		persist_seen_keys="$persist_seen_keys $persist_key_token"
	done <"$persist_config_path"

	echo "[volatoo] validated $persist_policy_count persistence policies"
}

apply_persist_config() {
	persist_config_path=$1
	persist_config_line_number=0

	while IFS= read -r persist_config_line || [ -n "$persist_config_line" ]; do
		persist_config_line_number=$((persist_config_line_number + 1))
		parse_persist_config_line \
			"$persist_config_line" "$persist_config_line_number"
		if [ -z "$persist_policy" ]; then
			continue
		fi

		case $persist_policy in
			bind)
				persist_base=/state/volatoo/data/bind/$persist_key
				persist_root=$persist_base/root
				persist_initialized=$persist_base/initialized
				mkdir -p "$persist_base"
				if [ ! -f "$persist_initialized" ]; then
					echo "[volatoo] seeding bind policy $persist_target"
					if [ -d "$persist_root" ]; then
						if ! cp -a "/newroot$persist_target/." "$persist_root/"; then
							fatal persist.bind-seed \
								"could not resume seeding bind policy: $persist_target"
						fi
					elif ! cp -a "/newroot$persist_target" "$persist_root"; then
						fatal persist.bind-seed \
							"could not seed bind policy: $persist_target"
					fi
					if ! printf '1\n' >"$persist_initialized"; then
						fatal persist.bind-seed \
							"could not mark bind policy initialized: $persist_target"
					fi
				fi
				if ! mount --bind "$persist_root" "/newroot$persist_target"; then
					fatal persist.bind-mount \
						"could not bind persistent data at: $persist_target"
				fi
				echo "[volatoo] bind policy mounted: $persist_target"
				;;
			overlay)
				persist_base=/state/volatoo/data/overlay/$persist_key
				mkdir -p "$persist_base/upper" "$persist_base/work"
				if ! mount -t overlay \
					-o "lowerdir=/newroot$persist_target,upperdir=$persist_base/upper,workdir=$persist_base/work" \
					overlay "/newroot$persist_target"; then
					fatal persist.overlay-mount \
						"could not mount persistent overlay at: $persist_target"
				fi
				echo "[volatoo] overlay policy mounted: $persist_target"
				;;
			sync)
				echo "[volatoo] sync policy registered: $persist_target"
				;;
		esac
	done <"$persist_config_path"
}

valid_generation_digest() {
	candidate_digest=$1
	if [ "${#candidate_digest}" -ne 71 ]; then
		return 1
	fi
	case $candidate_digest in
		sha256:*) ;;
		*) return 1 ;;
	esac
	case ${candidate_digest#sha256:} in
		'' | *[!0-9a-f]*) return 1 ;;
	esac
}

valid_sha256_hex() {
	candidate_sha256=$1
	if [ "${#candidate_sha256}" -ne 64 ]; then
		return 1
	fi
	case $candidate_sha256 in
		'' | *[!0-9a-f]*) return 1 ;;
	esac
}

valid_positive_decimal() {
	case $1 in
		'' | 0* | *[!0-9]*) return 1 ;;
		*) return 0 ;;
	esac
}

valid_nonnegative_decimal() {
	case $1 in
		0 | [1-9] | [1-9][0-9]*) return 0 ;;
		*) return 1 ;;
	esac
}

verify_generation_file_shape() {
	verify_path=$1
	verify_size=$2

	if [ -L "$verify_path" ] || [ ! -f "$verify_path" ]; then
		generation_error="missing or unsafe object: $verify_path"
		return 1
	fi
	if ! valid_positive_decimal "$verify_size"; then
		generation_error="object has invalid declared size: $verify_path"
		return 1
	fi
	if ! actual_size=$(stat -c %s "$verify_path" 2>/dev/null); then
		generation_error="could not inspect object size: $verify_path"
		return 1
	fi
	if [ "$actual_size" -ne "$verify_size" ]; then
		generation_error="object size mismatch: $verify_path"
		return 1
	fi
}

verify_generation_file() {
	verify_path=$1
	verify_digest=$2
	verify_size=${3:-}

	if [ -L "$verify_path" ] || [ ! -f "$verify_path" ]; then
		generation_error="missing or unsafe object: $verify_path"
		return 1
	fi
	if ! verify_output=$(sha256sum "$verify_path" 2>/dev/null); then
		generation_error="could not hash object: $verify_path"
		return 1
	fi
	if [ "${verify_output%% *}" != "${verify_digest#sha256:}" ]; then
		generation_error="object digest mismatch: $verify_path"
		return 1
	fi
	if [ -n "$verify_size" ]; then
		case $verify_size in
			'' | *[!0-9]*)
				generation_error="object has invalid declared size: $verify_path"
				return 1
				;;
		esac
		if [ "$verify_size" -lt 1 ]; then
			generation_error="object has invalid declared size: $verify_path"
			return 1
		fi
		if ! actual_size=$(stat -c %s "$verify_path" 2>/dev/null); then
			generation_error="could not inspect object size: $verify_path"
			return 1
		fi
		if [ "$actual_size" -ne "$verify_size" ]; then
			generation_error="object size mismatch: $verify_path"
			return 1
		fi
	fi
}

verify_generation_realization_signature() {
	signed_realization_path=$1
	signed_realization_digest=$2
	signature_directory=/state/volatoo/system/signatures/${signed_realization_digest#sha256:}
	signature_key_count=0
	signature_match_count=0
	signature_invalid=0

	if [ -L "$signature_directory" ] || \
		{ [ -e "$signature_directory" ] && [ ! -d "$signature_directory" ]; }; then
		generation_error="realization signature directory is unsafe"
		return 1
	fi
	if ! command -v signify >/dev/null 2>&1; then
		if [ "$signature_policy" = required ]; then
			generation_error="required realization signature verifier is unavailable"
			return 1
		fi
		echo "[volatoo] warning: signify is unavailable; accepting unsigned development generation"
		return 0
	fi

	for trusted_key in /etc/volatoo/trusted.d/*.pub; do
		if [ ! -e "$trusted_key" ] && [ ! -L "$trusted_key" ]; then
			continue
		fi
		if [ -L "$trusted_key" ] || [ ! -f "$trusted_key" ]; then
			generation_error="embedded realization trust key is unsafe"
			return 1
		fi
		signature_key_name=${trusted_key##*/}
		signature_key_hex=${signature_key_name%.pub}
		if [ "$signature_key_name" = "$signature_key_hex" ] || \
			! valid_sha256_hex "$signature_key_hex"; then
			generation_error="embedded realization trust key name is malformed"
			return 1
		fi
		if ! signature_key_checksum=$(sha256sum "$trusted_key" 2>/dev/null) || \
			[ "${signature_key_checksum%% *}" != "$signature_key_hex" ]; then
			generation_error="embedded realization trust key digest differs"
			return 1
		fi
		signature_key_count=$((signature_key_count + 1))
		signature_path=$signature_directory/$signature_key_hex.sig
		if [ ! -e "$signature_path" ] && [ ! -L "$signature_path" ]; then
			continue
		fi
		signature_match_count=$((signature_match_count + 1))
		if [ -L "$signature_path" ] || [ ! -f "$signature_path" ]; then
			generation_error="realization signature is unsafe"
			return 1
		fi
		if signify -V \
			-p "$trusted_key" \
			-x "$signature_path" \
			-m "$signed_realization_path" \
			>/dev/null 2>&1; then
			generation_signature_verified=1
			generation_signature_key_id=sha256:$signature_key_hex
			echo "[volatoo] realization signature verified: $generation_signature_key_id"
			return 0
		fi
		signature_invalid=1
	done

	if [ "$signature_invalid" -eq 1 ]; then
		generation_error="realization signature from a trusted key is invalid"
		return 1
	fi
	if [ "$signature_policy" = required ]; then
		if [ "$signature_key_count" -eq 0 ]; then
			generation_error="no realization trust key is embedded"
		elif [ "$signature_match_count" -eq 0 ]; then
			generation_error="realization has no signature from an embedded trust key"
		else
			generation_error="realization signature verification failed"
		fi
		return 1
	fi
	echo "[volatoo] warning: accepting unsigned development realization"
	return 0
}

generation_object_path() {
	object_digest=$1
	printf '/state/volatoo/system/objects/sha256/%s\n' \
			"${object_digest#sha256:}"
}

prepare_incremental_realization() {
	rm -f /generation/realization-images
	if ! IFS= read -r realization_line <&5; then
		generation_error="incremental realization has no tree record"
		return 1
	fi
	set -f
	# shellcheck disable=SC2086
	set -- $realization_line
	set +f
	if [ "$#" -ne 2 ] || [ "$1" != tree ] || \
		! valid_generation_digest "$2"; then
		generation_error="incremental realization tree record is malformed"
		return 1
	fi
	generation_realization_tree_digest=$2

	if ! IFS= read -r realization_line <&5; then
		generation_error="incremental realization has no FHS contract"
		return 1
	fi
	case $realization_line in
		tree-receipt\ *)
			set -f
			# shellcheck disable=SC2086
			set -- $realization_line
			set +f
			if [ "$#" -ne 2 ] || [ "$1" != tree-receipt ] || \
				! valid_generation_digest "$2"; then
				generation_error="incremental parent-tree receipt record is malformed"
				return 1
			fi
			generation_parent_tree_receipt_digest=$2
			generation_parent_tree_receipt_path=$(
				generation_object_path "$generation_parent_tree_receipt_digest"
			)
			if ! verify_generation_file \
				"$generation_parent_tree_receipt_path" \
				"$generation_parent_tree_receipt_digest"; then
				return 1
			fi
			if ! IFS= read -r realization_line <&5; then
				generation_error="incremental realization has no FHS contract"
				return 1
			fi
			;;
	esac
	if [ "$realization_line" != "fhs org.volatoo.gentoo-fhs/v1" ]; then
		generation_error="incremental realization FHS contract is unsupported"
		return 1
	fi
	generation_fhs_contract=org.volatoo.gentoo-fhs/v1
	if ! IFS= read -r realization_line <&5 || \
		[ "$realization_line" != \
			"composition overlayfs-lowerdir whiteout-char-0-0" ]; then
		generation_error="incremental realization composition is unsupported"
		return 1
	fi

	expected_image_sequence=0
	while IFS= read -r realization_line <&5; do
		if [ "$realization_line" = \
			"verity-format 1 sha256 4096 4096 no-superblock" ]; then
			break
		fi
		set -f
		# Intentional splitting parses the token-only image record.
		# shellcheck disable=SC2086
		set -- $realization_line
		set +f
		if [ "$#" -ne 11 ] || [ "$1" != image ] || \
			! valid_nonnegative_decimal "$2" || \
			[ "$2" -ne "$expected_image_sequence" ] || \
			! valid_generation_digest "$4" || \
			! valid_generation_digest "$5" || \
			! valid_positive_decimal "$6" || \
			! valid_generation_digest "$7" || \
			! valid_positive_decimal "$8" || \
			! valid_sha256_hex "$9" || \
			! valid_sha256_hex "${10}" || \
			! valid_positive_decimal "${11}"; then
			generation_error="incremental realization image record is malformed"
			return 1
		fi
		if [ "$expected_image_sequence" -eq 0 ]; then
			if [ "$3" != base ] || [ "$4" != "$5" ]; then
				generation_error="incremental realization base binding differs"
				return 1
			fi
		elif [ "$3" != layer ]; then
			generation_error="incremental realization image order differs"
			return 1
		fi
		incremental_rootfs_size=$6
		incremental_hash_size=$8
		incremental_data_blocks=${11}
		if [ "$expected_image_sequence" -gt 64 ] || \
			[ "${#incremental_rootfs_size}" -gt 12 ] || \
			[ "${#incremental_hash_size}" -gt 12 ] || \
			[ "${#incremental_data_blocks}" -gt 12 ] || \
			[ $((incremental_rootfs_size % 4096)) -ne 0 ] || \
			[ $((incremental_hash_size % 4096)) -ne 0 ] || \
			[ $((incremental_rootfs_size / 4096)) -ne \
				"$incremental_data_blocks" ]; then
			generation_error="incremental realization image geometry is invalid"
			return 1
		fi
		incremental_rootfs_path=$(generation_object_path "$5")
		incremental_hash_path=$(generation_object_path "$7")
		if ! verify_generation_file_shape \
			"$incremental_rootfs_path" "$6" || \
			! verify_generation_file_shape \
				"$incremental_hash_path" "$8"; then
			return 1
		fi
		printf '%s %s %s %s %s %s %s %s %s %s %s\n' \
			"$2" \
			"$3" \
			"$5" \
			"$6" \
			"$incremental_rootfs_path" \
			"$7" \
			"$8" \
			"$incremental_hash_path" \
			"$9" \
			"${10}" \
			"${11}" \
			>>/generation/realization-images
		expected_image_sequence=$((expected_image_sequence + 1))
	done
	if [ "$realization_line" != \
		"verity-format 1 sha256 4096 4096 no-superblock" ] || \
		[ "$expected_image_sequence" -eq 0 ]; then
		generation_error="incremental realization has no complete image stack"
		return 1
	fi
	if ! IFS= read -r realization_line <&5 || \
		[ "$realization_line" != \
			"builder squashfs-tools 4.7.5 zstd 19 1048576 reproducible" ]; then
		generation_error="incremental realization builder is unsupported"
		return 1
	fi
	if ! IFS= read -r realization_line <&5 || \
		[ "$realization_line" != end ]; then
		generation_error="incremental realization has no end record"
		return 1
	fi
	if IFS= read -r _ <&5; then
		generation_error="incremental realization contains records after end"
		return 1
	fi
	IFS=' ' read -r \
		_incremental_sequence \
		_incremental_kind \
		generation_base_digest \
		generation_base_size \
		generation_base_path \
		_incremental_rest \
		</generation/realization-images
	generation_incremental=1
	generation_incremental_image_count=$expected_image_sequence
	generation_layer_count=0
	generation_realized=1
	generation_verity=1
	echo "[volatoo] incremental authenticated realization selected: $expected_image_sequence images"
	return 0
}

prepare_generation_realization() {
	realization_generation=$1
	realization_plan_digest=$2
	realization_target_id=$3
	realization_context_digest=$4
	realization_name=${realization_generation#sha256:}
	realization_pointer=/state/volatoo/system/realizations/$realization_name

	if [ ! -e "$realization_pointer" ] && [ ! -L "$realization_pointer" ]; then
		return 1
	fi
	if [ -L "$realization_pointer" ] || [ ! -f "$realization_pointer" ]; then
		generation_error="realization pointer is unsafe"
		return 2
	fi
	realization_pointer_lines=$(wc -l <"$realization_pointer")
	if [ "$realization_pointer_lines" -ne 1 ] || \
		! IFS= read -r generation_realization_digest \
			<"$realization_pointer" || \
		! valid_generation_digest "$generation_realization_digest"; then
		generation_error="realization pointer is malformed"
		return 2
	fi
	generation_realization_plan=$(
		generation_object_path "$generation_realization_digest"
	)
	if ! verify_generation_file \
		"$generation_realization_plan" \
		"$generation_realization_digest"; then
		return 2
	fi
	if ! verify_generation_realization_signature \
		"$generation_realization_plan" \
		"$generation_realization_digest"; then
		return 2
	fi

	exec 5<"$generation_realization_plan"
	if ! IFS= read -r realization_line <&5; then
		generation_error="realization plan has an invalid header"
		exec 5<&-
		return 2
	fi
	case $realization_line in
		VOLATOO_REALIZATION_V1) generation_realization_version=1 ;;
		VOLATOO_REALIZATION_V2) generation_realization_version=2 ;;
		VOLATOO_REALIZATION_V3) generation_realization_version=3 ;;
		*)
			generation_error="realization plan has an invalid header"
			exec 5<&-
			return 2
			;;
	esac
	if ! IFS= read -r realization_line <&5; then
		generation_error="realization plan has no generation record"
		exec 5<&-
		return 2
	fi
	set -f
	# Intentional splitting parses the token-only realization records.
	# shellcheck disable=SC2086
	set -- $realization_line
	set +f
	if [ "$#" -ne 2 ] || [ "$1" != generation ] || \
		[ "$2" != "$realization_generation" ]; then
		generation_error="realization generation binding differs"
		exec 5<&-
		return 2
	fi

	if ! IFS= read -r realization_line <&5; then
		generation_error="realization plan has no boot-plan record"
		exec 5<&-
		return 2
	fi
	set -f
	# shellcheck disable=SC2086
	set -- $realization_line
	set +f
	if [ "$#" -ne 2 ] || [ "$1" != boot-plan ] || \
		[ "$2" != "$realization_plan_digest" ]; then
		generation_error="realization boot-plan binding differs"
		exec 5<&-
		return 2
	fi

	if ! IFS= read -r realization_line <&5; then
		generation_error="realization plan has no target record"
		exec 5<&-
		return 2
	fi
	set -f
	# shellcheck disable=SC2086
	set -- $realization_line
	set +f
	if [ "$#" -ne 2 ] || [ "$1" != target ] || \
		[ "$2" != "$realization_target_id" ]; then
		generation_error="realization target binding differs"
		exec 5<&-
		return 2
	fi

	if ! IFS= read -r realization_line <&5; then
		generation_error="realization plan has no context record"
		exec 5<&-
		return 2
	fi
	set -f
	# shellcheck disable=SC2086
	set -- $realization_line
	set +f
	if [ "$#" -ne 2 ] || [ "$1" != context ] || \
		[ "$2" != "$realization_context_digest" ]; then
		generation_error="realization context binding differs"
		exec 5<&-
		return 2
	fi
	if [ "$generation_realization_version" -eq 3 ]; then
		if ! prepare_incremental_realization; then
			exec 5<&-
			return 2
		fi
		exec 5<&-
		return 0
	fi

	if ! IFS= read -r realization_line <&5; then
		generation_error="realization plan has no rootfs record"
		exec 5<&-
		return 2
	fi
	set -f
	# shellcheck disable=SC2086
	set -- $realization_line
	set +f
	if [ "$#" -ne 3 ] || [ "$1" != rootfs ] || \
		! valid_generation_digest "$2" || \
		! valid_positive_decimal "$3"; then
		generation_error="realization rootfs record is malformed"
		exec 5<&-
		return 2
	fi
	realization_rootfs_digest=$2
	realization_rootfs_size=$3

	if ! IFS= read -r realization_line <&5; then
		generation_error="realization plan has no tree record"
		exec 5<&-
		return 2
	fi
	set -f
	# shellcheck disable=SC2086
	set -- $realization_line
	set +f
	if [ "$#" -ne 2 ] || [ "$1" != tree ] || \
		! valid_generation_digest "$2"; then
		generation_error="realization tree record is malformed"
		exec 5<&-
		return 2
	fi
	generation_realization_tree_digest=$2

	if ! IFS= read -r realization_line <&5; then
		generation_error="realization plan has no builder record"
		exec 5<&-
		return 2
	fi
	case $realization_line in
		fhs\ *)
			set -f
			# shellcheck disable=SC2086
			set -- $realization_line
			set +f
			if [ "$#" -ne 2 ] || [ "$1" != fhs ] || \
				[ "$2" != org.volatoo.gentoo-fhs/v1 ]; then
				generation_error="realization FHS contract is unsupported"
				exec 5<&-
				return 2
			fi
			generation_fhs_contract=$2
			if ! IFS= read -r realization_line <&5; then
				generation_error="realization plan has no builder record"
				exec 5<&-
				return 2
			fi
			;;
	esac
	if [ "$generation_realization_version" -eq 2 ]; then
		if [ -z "$generation_fhs_contract" ]; then
			generation_error="realization v2 has no FHS contract"
			exec 5<&-
			return 2
		fi
		set -f
		# shellcheck disable=SC2086
		set -- $realization_line
		set +f
		if [ "$#" -ne 6 ] || [ "$1" != verity ] || \
			! valid_generation_digest "$2" || \
			! valid_positive_decimal "$3" || \
			! valid_sha256_hex "$4" || \
			! valid_sha256_hex "$5" || \
			! valid_positive_decimal "$6"; then
			generation_error="realization verity record is malformed"
			exec 5<&-
			return 2
		fi
		generation_verity_hash_digest=$2
		generation_verity_hash_size=$3
		generation_verity_root_hash=$4
		generation_verity_salt=$5
		generation_verity_data_blocks=$6
		if [ $((generation_verity_hash_size % 4096)) -ne 0 ]; then
			generation_error="realization verity hash size is unaligned"
			exec 5<&-
			return 2
		fi
		if [ $((realization_rootfs_size % 4096)) -ne 0 ] || \
			[ $((realization_rootfs_size / 4096)) -ne \
				"$generation_verity_data_blocks" ]; then
			generation_error="realization rootfs size differs from verity geometry"
			exec 5<&-
			return 2
		fi
		if ! IFS= read -r realization_line <&5 || \
			[ "$realization_line" != \
				"verity-format 1 sha256 4096 4096 no-superblock" ]; then
			generation_error="realization verity format is unsupported"
			exec 5<&-
			return 2
		fi
		if ! IFS= read -r realization_line <&5; then
			generation_error="realization plan has no builder record"
			exec 5<&-
			return 2
		fi
	fi
	if [ "$realization_line" != \
		"builder squashfs-tools 4.7.5 zstd 19 1048576 reproducible" ]; then
		generation_error="realization builder record is unsupported"
		exec 5<&-
		return 2
	fi
	if ! IFS= read -r realization_line <&5 || \
		[ "$realization_line" != end ]; then
		generation_error="realization plan has no end record"
		exec 5<&-
		return 2
	fi
	if IFS= read -r _ <&5; then
		generation_error="realization plan contains records after end"
		exec 5<&-
		return 2
	fi
	exec 5<&-

	realization_rootfs_path=$(
		generation_object_path "$realization_rootfs_digest"
	)
	if [ "$generation_realization_version" -eq 2 ]; then
		generation_verity_hash_path=$(
			generation_object_path "$generation_verity_hash_digest"
		)
		if ! verify_generation_file_shape \
			"$realization_rootfs_path" \
			"$realization_rootfs_size" || \
			! verify_generation_file_shape \
				"$generation_verity_hash_path" \
				"$generation_verity_hash_size"; then
			return 2
		fi
		generation_verity=1
	else
		if ! verify_generation_file \
			"$realization_rootfs_path" \
			"$realization_rootfs_digest" \
			"$realization_rootfs_size"; then
			return 2
		fi
	fi
	generation_base_digest=$realization_rootfs_digest
	generation_base_size=$realization_rootfs_size
	generation_base_path=$realization_rootfs_path
	generation_layer_count=0
	generation_realized=1
	if [ "$generation_verity" -eq 1 ]; then
		echo "[volatoo] realized generation selected for dm-verity: $generation_base_digest"
	else
		echo "[volatoo] realized generation closure verified: $generation_base_digest"
	fi
	return 0
}

valid_generation_path() {
	candidate_path=$1
	case $candidate_path in
		/*) ;;
		*) return 1 ;;
	esac
	if [ "$candidate_path" = / ] || \
		[ "${candidate_path%/}" != "$candidate_path" ]; then
		return 1
	fi
	case "/${candidate_path#/}/" in
		*//* | */../* | */./*) return 1 ;;
	esac
	case "$candidate_path/" in
		/dev/* | /proc/* | /run/* | /sys/* | /.volatoo/*) return 1 ;;
	esac
}

prepare_generation() {
	candidate_generation=$1
	generation_error=
	generation_selected=0
	generation_layer_count=0
	generation_target_id=
	generation_context_digest=
	generation_base_digest=
	generation_base_size=
	generation_base_path=
	generation_realized=0
	generation_realization_digest=
	generation_realization_version=
	generation_realization_tree_digest=
	generation_parent_tree_receipt_digest=
	generation_parent_tree_receipt_path=
	generation_fhs_contract=
	generation_verity=0
	generation_verity_hash_digest=
	generation_verity_hash_size=
	generation_verity_hash_path=
	generation_verity_root_hash=
	generation_verity_salt=
	generation_verity_data_blocks=
	generation_incremental=0
	generation_incremental_image_count=0
	generation_signature_verified=0
	generation_signature_key_id=
	rm -f /generation/layers
	rm -f /generation/realization-images
	for stale_tombstones in /generation/tombstones.*; do
		if [ -e "$stale_tombstones" ] || [ -L "$stale_tombstones" ]; then
			rm -f "$stale_tombstones"
		fi
	done

	if ! valid_generation_digest "$candidate_generation"; then
		generation_error="malformed generation digest: $candidate_generation"
		return 1
	fi
	generation_name=${candidate_generation#sha256:}
	generation_manifest=/state/volatoo/system/manifests/$generation_name.json
	if ! verify_generation_file \
		"$generation_manifest" "$candidate_generation"; then
		return 1
	fi

	generation_plan_pointer=/state/volatoo/system/plans/$generation_name
	if [ -L "$generation_plan_pointer" ] || \
		[ ! -f "$generation_plan_pointer" ]; then
		generation_error="missing or unsafe boot plan pointer"
		return 1
	fi
	plan_pointer_lines=$(wc -l <"$generation_plan_pointer")
	if [ "$plan_pointer_lines" -ne 1 ] || \
		! IFS= read -r generation_plan_digest \
			<"$generation_plan_pointer" || \
		! valid_generation_digest "$generation_plan_digest"; then
		generation_error="malformed boot plan pointer"
		return 1
	fi
	generation_plan=$(generation_object_path "$generation_plan_digest")
	if ! verify_generation_file \
		"$generation_plan" "$generation_plan_digest"; then
		return 1
	fi

	exec 4<"$generation_plan"
	if ! IFS= read -r plan_line <&4 || \
		[ "$plan_line" != VOLATOO_GENERATION_V1 ]; then
		generation_error="boot plan has an invalid header"
		exec 4<&-
		return 1
	fi
	if ! IFS= read -r plan_line <&4; then
		generation_error="boot plan has no generation record"
		exec 4<&-
		return 1
	fi
	set -f
	# Intentional splitting parses the token-only boot-plan records.
	# shellcheck disable=SC2086
	set -- $plan_line
	set +f
	if [ "$#" -ne 2 ] || [ "$1" != generation ] || \
		[ "$2" != "$candidate_generation" ]; then
		generation_error="boot plan generation record differs"
		exec 4<&-
		return 1
	fi

	if ! IFS= read -r plan_line <&4; then
		generation_error="boot plan has no target record"
		exec 4<&-
		return 1
	fi
	set -f
	# shellcheck disable=SC2086
	set -- $plan_line
	set +f
	if [ "$#" -ne 2 ] || [ "$1" != target ]; then
		generation_error="boot plan target record is malformed"
		exec 4<&-
		return 1
	fi
	generation_target_id=$2
	case $generation_target_id in
		*/*) ;;
		*)
			generation_error="boot plan target is not an identifier"
			exec 4<&-
			return 1
			;;
	esac
	case $generation_target_id in
		*[!abcdefghijklmnopqrstuvwxyz0123456789._+/-]*)
			generation_error="boot plan target contains unsupported characters"
			exec 4<&-
			return 1
			;;
	esac

	if ! IFS= read -r plan_line <&4; then
		generation_error="boot plan has no context record"
		exec 4<&-
		return 1
	fi
	set -f
	# shellcheck disable=SC2086
	set -- $plan_line
	set +f
	if [ "$#" -ne 2 ] || [ "$1" != context ] || \
		! valid_generation_digest "$2"; then
		generation_error="boot plan context record is malformed"
		exec 4<&-
		return 1
	fi
	generation_context_digest=$2
	context_object=$(generation_object_path "$generation_context_digest")
	if ! verify_generation_file \
			"$context_object" "$generation_context_digest"; then
			exec 4<&-
			return 1
		fi

	prepare_generation_realization \
		"$candidate_generation" \
		"$generation_plan_digest" \
		"$generation_target_id" \
		"$generation_context_digest"
	realization_status=$?
	case $realization_status in
		0)
			exec 4<&-
			generation_digest=$candidate_generation
			generation_selected=1
			image_sha256=${candidate_generation#sha256:}
			if [ "$generation_verity" -eq 1 ]; then
				echo "[volatoo] generation binding verified for authenticated reads: $generation_digest"
			else
				echo "[volatoo] generation verified from realized closure: $generation_digest"
			fi
			return 0
			;;
		1) ;;
		*)
			exec 4<&-
			return 1
			;;
	esac
	if [ "$signature_policy" = required ]; then
		generation_error="signed release policy requires a realized generation"
		exec 4<&-
		return 1
	fi
	echo "[volatoo] warning: accepting unsigned legacy generation plan"

	if ! IFS= read -r plan_line <&4; then
		generation_error="boot plan has no base record"
		exec 4<&-
		return 1
	fi
	set -f
	# shellcheck disable=SC2086
	set -- $plan_line
	set +f
	if [ "$#" -ne 3 ] || [ "$1" != base ] || \
		! valid_generation_digest "$2"; then
		generation_error="boot plan base record is malformed"
		exec 4<&-
		return 1
	fi
	generation_base_digest=$2
	generation_base_size=$3
	generation_base_path=$(generation_object_path "$generation_base_digest")
	if ! verify_generation_file \
		"$generation_base_path" \
		"$generation_base_digest" \
		"$generation_base_size"; then
		exec 4<&-
		return 1
	fi

	while IFS= read -r plan_line <&4; do
		if [ "$plan_line" = end ]; then
			if IFS= read -r _ <&4; then
				generation_error="boot plan contains records after end"
				exec 4<&-
				return 1
			fi
			exec 4<&-
			generation_digest=$candidate_generation
			generation_selected=1
			image_sha256=${candidate_generation#sha256:}
			echo "[volatoo] generation verified: $generation_digest"
			return 0
		fi

		set -f
		# shellcheck disable=SC2086
		set -- $plan_line
		set +f
		if [ "$#" -ne 5 ] || [ "$1" != layer ] || \
			! valid_generation_digest "$2" || \
			! valid_generation_digest "$4" || \
			! valid_generation_digest "$5"; then
			generation_error="boot plan layer record is malformed"
			exec 4<&-
			return 1
		fi
		generation_layer_digest=$2
		generation_layer_size=$3
		generation_tombstones_digest=$4
		generation_transaction_digest=$5
		generation_layer_path=$(
			generation_object_path "$generation_layer_digest"
		)
		if ! verify_generation_file \
			"$generation_layer_path" \
			"$generation_layer_digest" \
			"$generation_layer_size"; then
			exec 4<&-
			return 1
		fi
		generation_tombstones_path=$(
			generation_object_path "$generation_tombstones_digest"
		)
		if ! verify_generation_file \
			"$generation_tombstones_path" \
			"$generation_tombstones_digest"; then
			exec 4<&-
			return 1
		fi
		generation_transaction_path=$(
			generation_object_path "$generation_transaction_digest"
		)
		if ! verify_generation_file \
			"$generation_transaction_path" \
			"$generation_transaction_digest"; then
			exec 4<&-
			return 1
		fi

		generation_layer_count=$((generation_layer_count + 1))
		if [ "$generation_layer_count" -gt 128 ]; then
			generation_error="boot plan exceeds 128 layers"
			exec 4<&-
			return 1
		fi
		printf '%s %s %s %s %s\n' \
			"$generation_layer_count" \
			"$generation_layer_digest" \
			"$generation_layer_size" \
			"$generation_tombstones_digest" \
			"$generation_transaction_digest" \
			>>/generation/layers

		while IFS= read -r plan_line <&4; do
			if [ "$plan_line" = endlayer ]; then
				break
			fi
			case $plan_line in
				remove\ *) generation_remove_path=${plan_line#remove } ;;
				*)
					generation_error="boot plan layer body is malformed"
					exec 4<&-
					return 1
					;;
			esac
			if ! valid_generation_path "$generation_remove_path"; then
				generation_error="boot plan has unsafe tombstone: $generation_remove_path"
				exec 4<&-
				return 1
			fi
			printf '%s\n' "$generation_remove_path" \
				>>"/generation/tombstones.$generation_layer_count"
		done
		if [ "$plan_line" != endlayer ]; then
			generation_error="boot plan layer is not terminated"
			exec 4<&-
			return 1
		fi
	done

	generation_error="boot plan has no end record"
	exec 4<&-
	return 1
}

prepare_generation_pointer() {
	pointer_name=$1
	pointer_path=/state/volatoo/system/$pointer_name
	if [ -L "$pointer_path" ] || [ ! -f "$pointer_path" ]; then
		generation_error="$pointer_name pointer is missing or unsafe"
		return 1
	fi
	pointer_lines=$(wc -l <"$pointer_path")
	if [ "$pointer_lines" -ne 1 ] || \
		! IFS= read -r pointer_digest <"$pointer_path"; then
		generation_error="$pointer_name pointer is malformed"
		return 1
	fi
	prepare_generation "$pointer_digest"
}

select_generation_from_state() {
	if [ "$generation_mode" = none ]; then
		echo "[volatoo] generation selection disabled for this boot"
		return
	fi
	if [ "$system_layout_version" != 1 ]; then
		case $generation_mode in
			auto)
				echo "[volatoo] state has no system generation layout"
				return
				;;
			*)
				fatal generation.layout \
					"selected generation mode requires system layout version 1"
				;;
		esac
	fi

	case $generation_mode in
		auto)
			if [ ! -e /state/volatoo/system/current ] && \
				[ ! -L /state/volatoo/system/current ]; then
				echo "[volatoo] no current generation; using configured image"
				return
			fi
			if prepare_generation_pointer current; then
				return
			fi
			current_generation_error=$generation_error
			echo "[volatoo] warning: current generation rejected: $generation_error"
			if prepare_generation_pointer previous; then
				echo "[volatoo] warning: booting verified previous generation"
				return
			fi
			fatal generation.unbootable \
				"current failed ($current_generation_error); previous failed ($generation_error)"
			;;
		previous)
			if ! prepare_generation_pointer previous; then
				fatal generation.previous "$generation_error"
			fi
			;;
		sha256:*)
			if ! prepare_generation "$generation_mode"; then
				fatal generation.selected "$generation_error"
			fi
			;;
	esac
}

apply_generation_layers() {
	if [ "$generation_selected" -ne 1 ] || \
		[ "$generation_layer_count" -eq 0 ]; then
		return
	fi

	echo "[volatoo] applying $generation_layer_count generation layers"
	while IFS=' ' read -r \
		layer_number \
		layer_digest \
		_layer_size \
		_layer_tombstones_digest \
		_layer_transaction_digest; do
		tombstone_file=/generation/tombstones.$layer_number
		if [ -f "$tombstone_file" ]; then
			while IFS= read -r tombstone_path || \
				[ -n "$tombstone_path" ]; do
				echo "[volatoo] removing generation path: $tombstone_path"
				if ! rm -rf "/newroot$tombstone_path"; then
					fatal generation.tombstone \
						"could not remove path: $tombstone_path"
				fi
			done <"$tombstone_file"
		fi

		layer_object=$(generation_object_path "$layer_digest")
		layer_loop_device=$(losetup -f)
		if [ -z "$layer_loop_device" ] || \
			! losetup -r "$layer_loop_device" "$layer_object"; then
			fatal generation.layer-loop \
				"could not attach layer $layer_number"
		fi
		if ! mount -t squashfs -o ro "$layer_loop_device" /layer; then
			losetup -d "$layer_loop_device" || true
			fatal generation.layer-mount \
				"could not mount layer $layer_number"
		fi
		if ! cp -a /layer/. /newroot/; then
			umount /layer || true
			losetup -d "$layer_loop_device" || true
			fatal generation.layer-copy \
				"could not apply layer $layer_number"
		fi
		umount /layer ||
			fatal generation.layer-unmount \
				"could not unmount layer $layer_number"
		losetup -d "$layer_loop_device" ||
			fatal generation.layer-detach \
				"could not detach layer $layer_number"
		echo "[volatoo] generation layer applied: $layer_number"
	done </generation/layers
}

mount_incremental_realization() {
	if [ "$generation_incremental" -ne 1 ]; then
		return
	fi
	if ! command -v veritysetup >/dev/null 2>&1; then
		fatal generation.verity-helper \
			"realization v3 requires veritysetup in early userspace"
	fi
	mkdir -p /dev/mapper /run/cryptsetup /lower
	rm -f /generation/verity-devices
	incremental_lowerdirs=
	while IFS=' ' read -r \
		incremental_sequence \
		_incremental_kind \
		_incremental_rootfs_digest \
		incremental_rootfs_size \
		incremental_rootfs_path \
		_incremental_hash_digest \
		_incremental_hash_size \
		incremental_hash_path \
		incremental_root_hash \
		incremental_salt \
		incremental_data_blocks; do
		incremental_data_loop=$(losetup -f)
		if [ -z "$incremental_data_loop" ] || \
			! losetup -r \
				"$incremental_data_loop" \
				"$incremental_rootfs_path"; then
			fatal generation.incremental-data-loop \
				"could not attach realization image $incremental_sequence"
		fi
		incremental_hash_loop=$(losetup -f)
		if [ -z "$incremental_hash_loop" ] || \
			! losetup -r \
				"$incremental_hash_loop" \
				"$incremental_hash_path"; then
			losetup -d "$incremental_data_loop" 2>/dev/null || true
			fatal generation.incremental-hash-loop \
				"could not attach realization hash $incremental_sequence"
		fi
		incremental_mapping=volatoo-lower-$incremental_sequence
		if ! veritysetup open \
			"$incremental_data_loop" \
			"$incremental_mapping" \
			"$incremental_hash_loop" \
			"$incremental_root_hash" \
			--no-superblock \
			--hash=sha256 \
			--data-block-size=4096 \
			--hash-block-size=4096 \
			--data-blocks="$incremental_data_blocks" \
			--salt="$incremental_salt"; then
			losetup -d "$incremental_hash_loop" 2>/dev/null || true
			losetup -d "$incremental_data_loop" 2>/dev/null || true
			fatal generation.incremental-verity-open \
				"could not authenticate realization image $incremental_sequence"
		fi
		incremental_device=/dev/mapper/$incremental_mapping
		incremental_wait=0
		while [ ! -b "$incremental_device" ] && \
			[ "$incremental_wait" -lt 100 ]; do
			incremental_wait=$((incremental_wait + 1))
			sleep 0.1
		done
		if [ ! -b "$incremental_device" ]; then
			fatal generation.incremental-verity-device \
				"authenticated image device did not appear: $incremental_sequence"
		fi
		incremental_mount=/lower/$incremental_sequence
		mkdir "$incremental_mount"
		if ! mount -t squashfs -o ro \
			"$incremental_device" "$incremental_mount"; then
			fatal generation.incremental-squashfs \
				"could not mount realization image $incremental_sequence"
		fi
		if [ -n "$incremental_lowerdirs" ]; then
			incremental_lowerdirs=$incremental_mount:$incremental_lowerdirs
		else
			incremental_lowerdirs=$incremental_mount
		fi
		printf '%s %s %s %s %s\n' \
			"$incremental_sequence" \
			"$incremental_mapping" \
			"$incremental_data_loop" \
			"$incremental_hash_loop" \
			"$incremental_mount" \
			>>/generation/verity-devices
		echo "[volatoo] authenticated realization image ready: $incremental_sequence"
	done </generation/realization-images
	if [ -z "$incremental_lowerdirs" ] || \
		! mount -t overlay \
			-o "lowerdir=$incremental_lowerdirs" \
			overlay /image; then
		fatal generation.incremental-overlay \
			"could not compose the authenticated FHS layer stack"
	fi
	echo "[volatoo] authenticated incremental FHS root composed"
}

release_incremental_realization() {
	if [ "$generation_incremental" -ne 1 ]; then
		return
	fi
	while IFS=' ' read -r \
		_incremental_sequence \
		incremental_mapping \
		incremental_data_loop \
		incremental_hash_loop \
		incremental_mount; do
		umount "$incremental_mount" || true
		veritysetup close "$incremental_mapping" || true
		losetup -d "$incremental_hash_loop" || true
		losetup -d "$incremental_data_loop" || true
	done </generation/verity-devices
}

preserve_incremental_mounts() {
	if [ "$generation_incremental" -ne 1 ]; then
		return
	fi
	mkdir -p /newroot/.volatoo/layers
	while IFS=' ' read -r \
		incremental_sequence \
		_incremental_mapping \
		_incremental_data_loop \
		_incremental_hash_loop \
		incremental_mount; do
		incremental_destination=/newroot/.volatoo/layers/$incremental_sequence
		mkdir "$incremental_destination"
		mount --move "$incremental_mount" "$incremental_destination" ||
			fatal root.move-incremental-layer \
				"could not preserve realization image $incremental_sequence"
	done </generation/verity-devices
}

config_file=/etc/volatoo/initramfs.conf
if [ -r "$config_file" ]; then
	# The configuration is trusted input baked into the initramfs.
	# shellcheck disable=SC1090
	. "$config_file"
fi

image_spec=${VOLATOO_IMAGE:-/dev/vda}
image_file=${VOLATOO_IMAGE_FILE:-}
image_sha256=${VOLATOO_IMAGE_SHA256:-}
actual_image_sha256=
ram_image_sha256=
target_init=${VOLATOO_INIT:-/sbin/init}
root_mode=${VOLATOO_ROOT_MODE:-store-overlay}
tmpfs_size=${VOLATOO_TMPFS_SIZE:-80%}
state_spec=${VOLATOO_STATE:-LABEL=VOLATOO-STATE}
state_required=${VOLATOO_STATE_REQUIRED:-no}
generation_mode=${VOLATOO_GENERATION:-auto}
signature_policy=${VOLATOO_SIGNATURE_POLICY:-required}
state_device=
state_mounted=0
system_store_readonly=0
state_layout_version=
system_layout_version=
generation_selected=0
generation_digest=
generation_error=
generation_incremental=0
generation_incremental_image_count=0
persist_config=
persist_sync_configured=0

mkdir -p \
		/dev /generation /image /layer /lower /newroot /overlay /proc /ramimage \
	/source /state /sys

if ! mount -t devtmpfs devtmpfs /dev; then
	fatal mount.devtmpfs "could not mount devtmpfs at /dev"
fi

if ! mount -t proc proc /proc; then
	fatal mount.proc "could not mount proc at /proc"
fi

if ! mount -t sysfs sysfs /sys; then
	fatal mount.sysfs "could not mount sysfs at /sys"
fi

# The kernel command line is intentionally parsed as whitespace-delimited words.
# shellcheck disable=SC2013
for argument in $(cat /proc/cmdline 2>/dev/null); do
	case $argument in
		volatoo.image=*) image_spec=${argument#volatoo.image=} ;;
		volatoo.image-file=*) image_file=${argument#volatoo.image-file=} ;;
		volatoo.image-sha256=*) image_sha256=${argument#volatoo.image-sha256=} ;;
		volatoo.init=*) target_init=${argument#volatoo.init=} ;;
		volatoo.root=*) root_mode=${argument#volatoo.root=} ;;
		volatoo.tmpfs-size=*) tmpfs_size=${argument#volatoo.tmpfs-size=} ;;
		volatoo.state=*) state_spec=${argument#volatoo.state=} ;;
		volatoo.state-required=*) state_required=${argument#volatoo.state-required=} ;;
		volatoo.generation=*) generation_mode=${argument#volatoo.generation=} ;;
		volatoo.signature-policy=*) signature_policy=${argument#volatoo.signature-policy=} ;;
	esac
done

case $image_spec in
	/*) ;;
	LABEL=*)
		if [ -z "${image_spec#LABEL=}" ]; then
			fatal config.image "image LABEL must not be empty"
		fi
		;;
	UUID=*)
		if [ -z "${image_spec#UUID=}" ]; then
			fatal config.image "image UUID must not be empty"
		fi
		;;
	*)
		fatal config.image \
			"image location must be /dev/..., LABEL=..., or UUID=..."
		;;
esac

case $image_file in
	'') ;;
	/*)
		case "/${image_file#/}/" in
			*/../* | */./*)
				fatal config.image-file \
					"image file must not contain . or .. components"
				;;
		esac
		;;
	*)
		fatal config.image-file \
			"image file must be an absolute path: $image_file"
		;;
esac

if [ -n "$image_sha256" ]; then
	if [ "${#image_sha256}" -ne 64 ]; then
		fatal config.image-sha256 \
			"image SHA-256 must contain exactly 64 lowercase hexadecimal characters"
	fi
	case $image_sha256 in
		*[!0-9a-f]*)
			fatal config.image-sha256 \
				"image SHA-256 must contain exactly 64 lowercase hexadecimal characters"
			;;
	esac
fi

case $target_init in
	/*) ;;
	*)
		fatal config.init \
			"target init must be an absolute path: $target_init"
		;;
esac

case $root_mode in
	copy | overlay | ram-overlay | store-overlay) ;;
	*)
		fatal config.root-mode "unsupported root mode: $root_mode"
		;;
esac

case $tmpfs_size in
	*%)
		tmpfs_percent=${tmpfs_size%\%}
		case $tmpfs_percent in
			'' | *[!0-9]*)
				fatal config.tmpfs-size \
					"tmpfs size must be a percentage: $tmpfs_size"
				;;
		esac
		if [ "$tmpfs_percent" -lt 1 ] || [ "$tmpfs_percent" -gt 100 ]; then
			fatal config.tmpfs-size \
				"tmpfs percentage must be between 1 and 100"
		fi
		;;
	*)
		fatal config.tmpfs-size \
			"tmpfs size must be a percentage: $tmpfs_size"
		;;
esac

case $state_spec in
	none) ;;
	/dev/*) ;;
	LABEL=*)
		if [ -z "${state_spec#LABEL=}" ]; then
			fatal config.state "state LABEL must not be empty"
		fi
		;;
	UUID=*)
		if [ -z "${state_spec#UUID=}" ]; then
			fatal config.state "state UUID must not be empty"
		fi
		;;
	*)
		fatal config.state \
			"state location must be none, /dev/..., LABEL=..., or UUID=..."
		;;
esac

case $state_required in
	yes | no) ;;
	*)
		fatal config.state-required \
			"state-required must be yes or no: $state_required"
		;;
esac

if [ "$state_spec" = none ] && [ "$state_required" = yes ]; then
	fatal config.state-required \
		"state-required=yes cannot be combined with state=none"
fi

case $generation_mode in
	auto | previous | none | sha256:*)
		;;
	*)
		fatal config.generation \
			"generation must be auto, previous, none, or sha256:<digest>"
		;;
esac

case $signature_policy in
	required | allow-unsigned) ;;
	*)
		fatal config.signature-policy \
			"signature-policy must be required or allow-unsigned: $signature_policy"
		;;
esac

echo "[volatoo] kernel: $(uname -srmo)"
echo "[volatoo] command line: $(cat /proc/cmdline 2>/dev/null)"

# A development kernel may provide these as modules; the target Volatoo kernel
# will build required boot and baseline network drivers in. Failure is harmless
# for built-in drivers.
load_module virtio_blk
load_module virtio_net
for network_interface_path in /sys/class/net/*; do
	if [ -e "$network_interface_path" ]; then
		echo "[volatoo] network interface available: ${network_interface_path##*/}"
	fi
done
load_module xhci_pci
load_module usb_storage
load_module sd_mod
load_module loop
load_module dm_mod
load_module dm_bufio
load_module reed_solomon
load_module dm_verity
load_module squashfs
load_module overlay
load_module ext4
load_module isofs

attempt=0
image_device=
while [ "$attempt" -lt 100 ]; do
	image_candidates=$(resolve_device_spec "$image_spec")
	image_device=
	for candidate in $image_candidates; do
		if [ -n "$image_device" ] && [ "$candidate" != "$image_device" ]; then
			fatal image.ambiguous \
				"multiple devices match the image location: $image_spec"
		fi
		image_device=$candidate
	done
	if [ -n "$image_device" ] && [ -b "$image_device" ]; then
		break
	fi
	attempt=$((attempt + 1))
	sleep 0.1
done

if [ -z "$image_device" ] || [ ! -b "$image_device" ]; then
	fatal image.not-found \
		"image device was not found within 10 seconds: $image_spec"
fi

echo "[volatoo] image device resolved: $image_spec -> $image_device"

if [ "$state_spec" = none ]; then
	echo "[volatoo] state partition discovery disabled"
else
	state_attempt_limit=1
	if [ "$state_required" = yes ]; then
		state_attempt_limit=100
	fi
	state_attempt=0
	while [ "$state_attempt" -lt "$state_attempt_limit" ]; do
		state_candidates=$(resolve_device_spec "$state_spec")
		state_device=
		for candidate in $state_candidates; do
			if [ -n "$state_device" ] && [ "$candidate" != "$state_device" ]; then
				fatal state.ambiguous \
					"multiple devices match the state location: $state_spec"
			fi
			state_device=$candidate
		done
		if [ -n "$state_device" ] && [ -b "$state_device" ]; then
			break
		fi
		state_attempt=$((state_attempt + 1))
		if [ "$state_attempt" -lt "$state_attempt_limit" ]; then
			sleep 0.1
		fi
	done

	if [ -z "$state_device" ] || [ ! -b "$state_device" ]; then
		state_device=
		if [ "$state_required" = yes ]; then
			fatal state.not-found \
				"required state partition was not found within 10 seconds: $state_spec"
		fi
		echo "[volatoo] state partition not found; continuing without persistence"
	else
		echo "[volatoo] state device resolved: $state_spec -> $state_device"
		if ! mount -o rw "$state_device" /state; then
			fatal state.mount \
				"could not mount the state partition read-write: $state_device"
		fi
		state_mounted=1
		state_layout_file=/state/volatoo/layout-version
		if [ -L "$state_layout_file" ] || [ ! -f "$state_layout_file" ]; then
			fatal state.layout-missing \
				"state partition has no safe /volatoo/layout-version file"
		fi
		IFS= read -r state_layout_version <"$state_layout_file" || true
		if [ "$state_layout_version" != 1 ]; then
			fatal state.layout-version \
				"unsupported state layout version: ${state_layout_version:-empty}"
		fi
		for state_layout_directory in \
			/state/volatoo/config \
			/state/volatoo/data/bind \
			/state/volatoo/data/overlay \
			/state/volatoo/data/sync \
			/state/volatoo/snapshots; do
			if [ -L "$state_layout_directory" ] || \
				[ ! -d "$state_layout_directory" ]; then
				fatal state.layout-directory \
					"state layout has no safe directory: ${state_layout_directory#/state}"
			fi
		done
		if [ -e /state/volatoo/system ] || \
			[ -L /state/volatoo/system ]; then
			if [ -L /state/volatoo/system ] || \
				[ ! -d /state/volatoo/system ]; then
				fatal state.layout-directory \
					"state system layout is not a safe directory"
			fi
			system_layout_file=/state/volatoo/system/layout-version
			if [ -L "$system_layout_file" ] || \
				[ ! -f "$system_layout_file" ]; then
				fatal state.layout-missing \
					"state system layout has no safe layout-version file"
			fi
			IFS= read -r system_layout_version \
				<"$system_layout_file" || true
			if [ "$system_layout_version" != 1 ]; then
				fatal state.layout-version \
					"unsupported system layout version: ${system_layout_version:-empty}"
			fi
			for state_system_directory in \
				/state/volatoo/system/manifests \
				/state/volatoo/system/objects/sha256 \
				/state/volatoo/system/plans \
				/state/volatoo/system/staging; do
				if [ -L "$state_system_directory" ] || \
					[ ! -d "$state_system_directory" ]; then
					fatal state.layout-directory \
						"state layout has no safe directory: ${state_system_directory#/state}"
				fi
			done
			echo "[volatoo] system layout version 1 available"
		fi
		echo "[volatoo] state layout version $state_layout_version mounted read-write"
		if [ -L /state/volatoo/config/persist.conf ]; then
			fatal state.config \
				"persistence configuration must not be a symbolic link"
		elif [ -f /state/volatoo/config/persist.conf ]; then
			persist_config=/state/volatoo/config/persist.conf
			echo "[volatoo] persistence configuration found"
		elif [ -e /state/volatoo/config/persist.conf ]; then
			fatal state.config \
				"persistence configuration is not a regular file"
		else
			echo "[volatoo] no persistence configuration; state is available but unused"
		fi
	fi
fi

if [ "$state_mounted" -eq 1 ]; then
	select_generation_from_state
elif [ "$generation_mode" != auto ] && [ "$generation_mode" != none ]; then
	fatal generation.state \
		"explicit generation selection requires a mounted state filesystem"
fi

image_source=$image_device
image_copy_source=$image_device
ram_image_expected_sha256=$image_sha256
loop_device=
verity_data_loop_device=
verity_hash_loop_device=
verity_mapping=
source_mounted=0
if [ "$generation_selected" -eq 1 ]; then
	if [ "$generation_incremental" -eq 1 ]; then
		if [ "$root_mode" = ram-overlay ]; then
			fatal generation.incremental-ram-overlay \
				"realization v3 currently requires store-overlay, overlay, or copy mode"
		fi
	else
		image_copy_source=$generation_base_path
		ram_image_expected_sha256=${generation_base_digest#sha256:}
	fi
	if [ "$generation_incremental" -ne 1 ] && \
		[ "$root_mode" != ram-overlay ]; then
		if [ "$generation_verity" -eq 1 ]; then
			if ! command -v veritysetup >/dev/null 2>&1; then
				fatal generation.verity-helper \
					"realization v2 requires veritysetup in early userspace"
			fi
			mkdir -p /dev/mapper /run/cryptsetup
			verity_data_loop_device=$(losetup -f)
			if [ -z "$verity_data_loop_device" ] || \
				! losetup -r \
					"$verity_data_loop_device" \
					"$generation_base_path"; then
				fatal generation.verity-data-loop \
					"could not attach the dm-verity data object"
			fi
			verity_hash_loop_device=$(losetup -f)
			if [ -z "$verity_hash_loop_device" ] || \
				! losetup -r \
					"$verity_hash_loop_device" \
					"$generation_verity_hash_path"; then
				losetup -d "$verity_data_loop_device" 2>/dev/null || true
				fatal generation.verity-hash-loop \
					"could not attach the dm-verity hash object"
			fi
			verity_mapping=volatoo-root
			if ! veritysetup open \
				"$verity_data_loop_device" \
				"$verity_mapping" \
				"$verity_hash_loop_device" \
				"$generation_verity_root_hash" \
				--no-superblock \
				--hash=sha256 \
				--data-block-size=4096 \
				--hash-block-size=4096 \
				--data-blocks="$generation_verity_data_blocks" \
				--salt="$generation_verity_salt"; then
				losetup -d "$verity_hash_loop_device" 2>/dev/null || true
				losetup -d "$verity_data_loop_device" 2>/dev/null || true
				fatal generation.verity-open \
					"could not create the authenticated root mapping"
			fi
			image_source=/dev/mapper/$verity_mapping
			verity_wait=0
			while [ ! -b "$image_source" ] && \
				[ "$verity_wait" -lt 100 ]; do
				verity_wait=$((verity_wait + 1))
				sleep 0.1
			done
			if [ ! -b "$image_source" ]; then
				veritysetup close "$verity_mapping" 2>/dev/null || true
				losetup -d "$verity_hash_loop_device" 2>/dev/null || true
				losetup -d "$verity_data_loop_device" 2>/dev/null || true
				fatal generation.verity-device \
					"dm-verity mapping did not publish a block device"
			fi
			echo "[volatoo] authenticated generation mapping ready: $image_source"
		else
			loop_device=$(losetup -f)
			if [ -z "$loop_device" ] || \
				! losetup -r "$loop_device" "$generation_base_path"; then
				fatal generation.base-loop \
					"could not attach selected generation base"
			fi
			image_source=$loop_device
			echo "[volatoo] selected generation base attached: $generation_base_digest"
		fi
	fi
elif [ -n "$image_file" ]; then
	echo "[volatoo] mounting image container from $image_device"
	if ! mount -o ro "$image_device" /source; then
		fatal image.container-mount \
			"could not mount the image container: $image_device"
	fi
	source_mounted=1

	if [ ! -f "/source$image_file" ]; then
		fatal image.file-not-found \
			"squashfs file not found in container: $image_file"
	fi

	verify_image_integrity "/source$image_file"
	image_copy_source=/source$image_file

	if [ "$root_mode" != ram-overlay ]; then
		loop_device=$(losetup -f)
		if [ -z "$loop_device" ] || \
			! losetup -r "$loop_device" "/source$image_file"; then
			fatal image.loop-setup \
				"could not create a read-only loop device for: $image_file"
		fi
		image_source=$loop_device
		echo "[volatoo] squashfs file attached: $image_file -> $loop_device"
	fi
else
	verify_image_integrity "$image_device"
fi

if [ "$root_mode" = ram-overlay ]; then
	if ! mount -t tmpfs -o "mode=0755,size=$tmpfs_size" \
		tmpfs /ramimage; then
		fatal root.ram-image-tmpfs \
			"could not mount tmpfs for the compressed root image"
	fi

	if [ -z "$ram_image_expected_sha256" ]; then
		echo "[volatoo] calculating an untrusted source snapshot digest"
		if ! checksum_output=$(sha256sum "$image_copy_source" 2>/dev/null); then
			fatal root.ram-image-source-hash \
				"could not hash the source image before copying it to RAM"
		fi
		ram_image_expected_sha256=${checksum_output%% *}
	fi

	ram_copy_started=$(date +%s)
	echo "[volatoo] copying the compressed root image into RAM"
	if ! cp "$image_copy_source" /ramimage/root.squashfs; then
		fatal root.ram-image-copy \
			"could not copy the compressed root image into RAM"
	fi
	if ! checksum_output=$(sha256sum /ramimage/root.squashfs 2>/dev/null); then
		fatal root.ram-image-hash \
			"could not hash the RAM-backed root image"
	fi
	ram_image_sha256=${checksum_output%% *}
	if [ "$ram_image_sha256" != "$ram_image_expected_sha256" ]; then
		fatal root.ram-image-integrity \
			"RAM-backed root image SHA-256 mismatch"
	fi
	ram_copy_finished=$(date +%s)
	echo "[volatoo] compressed root copied and verified in $((ram_copy_finished - ram_copy_started))s"

	if ! mount -o remount,ro /ramimage; then
		fatal root.ram-image-readonly \
			"could not make the RAM-backed root image read-only"
	fi
	if [ "$source_mounted" -eq 1 ]; then
		if ! umount /source; then
			fatal root.ram-image-source-unmount \
				"could not release the source image container"
		fi
		source_mounted=0
	fi

	loop_device=$(losetup -f)
	if [ -z "$loop_device" ] || \
		! losetup -r "$loop_device" /ramimage/root.squashfs; then
		fatal root.ram-image-loop \
			"could not attach the RAM-backed root image"
	fi
	image_source=$loop_device
	echo "[volatoo] source image released; RAM lower attached: $loop_device"
fi

if [ "$generation_incremental" -eq 1 ]; then
	mount_incremental_realization
else
	echo "[volatoo] mounting squashfs from $image_source"
	if ! mount -t squashfs -o ro "$image_source" /image; then
		fatal image.squashfs-mount \
			"could not mount squashfs from: $image_source"
	fi
fi
echo "[volatoo] root authentication stage complete"

case $root_mode in
	copy)
		if ! mount -t tmpfs -o "mode=0755,size=$tmpfs_size" tmpfs /newroot; then
			fatal root.tmpfs-mount \
				"could not mount tmpfs at /newroot"
		fi

		copy_started=$(date +%s)
		echo "[volatoo] copying the root filesystem into tmpfs"
		if ! cp -a /image/. /newroot/; then
			fatal root.copy "could not populate the tmpfs root"
		fi
		copy_finished=$(date +%s)

		echo "[volatoo] root copy completed in $((copy_finished - copy_started))s"
		;;
	overlay | store-overlay)
		if ! mount -t tmpfs -o "mode=0755,size=$tmpfs_size" tmpfs /overlay; then
			fatal root.overlay-tmpfs \
				"could not mount the overlay write layer"
		fi
		mkdir -p /overlay/upper /overlay/work
		if ! mount -t overlay \
			-o lowerdir=/image,upperdir=/overlay/upper,workdir=/overlay/work \
			overlay /newroot; then
			fatal root.overlay-mount \
				"could not mount the overlay root"
		fi
		if [ "$root_mode" = store-overlay ]; then
			echo "[volatoo] immutable store overlay root ready"
		else
			echo "[volatoo] legacy overlay root ready"
		fi
		;;
	ram-overlay)
		if ! mount -t tmpfs -o "mode=0755,size=$tmpfs_size" tmpfs /overlay; then
			fatal root.ram-overlay-tmpfs \
				"could not mount the RAM overlay write layer"
		fi
		mkdir -p /overlay/upper /overlay/work
		if ! mount -t overlay \
			-o lowerdir=/image,upperdir=/overlay/upper,workdir=/overlay/work \
			overlay /newroot; then
			fatal root.ram-overlay-mount \
				"could not mount the RAM-backed overlay root"
		fi
		echo "[volatoo] RAM-backed overlay root ready"
		;;
esac

apply_generation_layers

if [ -n "$persist_config" ]; then
	validate_persist_config "$persist_config"
	if [ "$persist_sync_configured" -eq 1 ] && [ -z "$image_sha256" ]; then
		fatal persist.image-id \
			"sync policies require a verified image SHA-256"
	fi
	apply_persist_config "$persist_config"
fi

if [ "$generation_selected" -eq 1 ]; then
	mkdir -p /newroot/.volatoo
	if ! printf '%s\n' "$generation_digest" \
		>/newroot/.volatoo/generation-id; then
		fatal generation.identity \
			"could not publish the selected generation id"
	fi
	if [ "$generation_realized" -eq 1 ]; then
		if ! printf '%s\n' "$generation_realization_digest" \
			>/newroot/.volatoo/realization-id || \
			! printf '%s\n' "$generation_realization_tree_digest" \
			>/newroot/.volatoo/realization-tree-id; then
			fatal generation.identity \
				"could not publish the realized generation identity"
		fi
		if [ -n "$generation_fhs_contract" ] && \
			! printf '%s\n' "$generation_fhs_contract" \
				>/newroot/.volatoo/fhs-contract; then
			fatal generation.identity \
				"could not publish the realized FHS contract"
		fi
		if ! printf '%s\n' "$generation_realization_version" \
			>/newroot/.volatoo/realization-version; then
			fatal generation.identity \
				"could not publish the realization contract version"
		fi
		if [ "$generation_incremental" -eq 1 ]; then
			if ! printf 'dm-verity-layer-stack\n' \
				>/newroot/.volatoo/root-authentication || \
				! printf '%s\n' "$generation_incremental_image_count" \
					>/newroot/.volatoo/authenticated-image-count; then
				fatal generation.identity \
					"could not publish the authenticated layer-stack identity"
			fi
		elif [ "$generation_verity" -eq 1 ] && \
			[ "$root_mode" != ram-overlay ]; then
			if ! printf 'dm-verity\n' \
				>/newroot/.volatoo/root-authentication || \
				! printf '%s\n' "$generation_verity_root_hash" \
					>/newroot/.volatoo/verity-root-hash; then
				fatal generation.identity \
					"could not publish the dm-verity identity"
			fi
		elif ! printf 'sha256-eager\n' \
			>/newroot/.volatoo/root-authentication; then
			fatal generation.identity \
				"could not publish the root authentication mode"
		fi
	fi
	if [ "$generation_signature_verified" -eq 1 ]; then
		if ! printf 'signify-ed25519\n' \
			>/newroot/.volatoo/release-authentication || \
			! printf '%s\n' "$generation_signature_key_id" \
				>/newroot/.volatoo/signature-key; then
			fatal generation.identity \
				"could not publish the release signature identity"
		fi
	elif ! printf 'unsigned\n' \
		>/newroot/.volatoo/release-authentication; then
		fatal generation.identity \
			"could not publish the unsigned release identity"
	fi
fi

if [ ! -x "/newroot$target_init" ]; then
	fatal root.init-missing \
		"target init is not executable: $target_init"
fi

if [ "$state_mounted" -eq 1 ]; then
	mkdir -p /newroot/.volatoo/state
	mount --move /state /newroot/.volatoo/state ||
		fatal state.move "could not preserve the state partition mount"
	echo "[volatoo] state partition available at /.volatoo/state"
	protect_system_store /newroot/.volatoo/state
	if [ ! -x /newroot/usr/libexec/volatoo-persist-early ]; then
		fatal persist.helper-missing \
			"early persistence helper is not executable"
	fi
	if [ ! -x /newroot/usr/sbin/volatoo-identity ]; then
		fatal identity.helper-missing \
			"machine identity helper is not executable"
	fi
fi
if [ "$persist_sync_configured" -eq 1 ]; then
	if ! printf '%s\n' "$image_sha256" > /newroot/.volatoo/image-id; then
		fatal persist.image-id \
			"could not publish the verified image id"
	fi
fi

case $root_mode in
	copy)
		umount /image || true
		if [ "$generation_incremental" -eq 1 ]; then
			release_incremental_realization
		elif [ -n "$verity_mapping" ]; then
			veritysetup close "$verity_mapping" || true
			losetup -d "$verity_hash_loop_device" || true
			losetup -d "$verity_data_loop_device" || true
		elif [ -n "$loop_device" ]; then
			losetup -d "$loop_device" || true
		fi
		if [ "$source_mounted" -eq 1 ]; then
			umount /source || true
		fi
		;;
	overlay | store-overlay)
		# Keep the overlay's lower and writable backing mounts alive after the
		# initramfs is discarded by moving them beneath the new root.
		mkdir -p /newroot/.volatoo/lower /newroot/.volatoo/writable
		preserve_incremental_mounts
		mount --move /image /newroot/.volatoo/lower ||
			fatal root.move-lower "could not preserve the immutable lower mount"
		mount --move /overlay /newroot/.volatoo/writable ||
			fatal root.move-writable "could not preserve the overlay write mount"
		if [ "$source_mounted" -eq 1 ]; then
			mkdir -p /newroot/.volatoo/source
			mount --move /source /newroot/.volatoo/source ||
				fatal root.move-source \
					"could not preserve the image container mount"
		fi
		;;
	ram-overlay)
		# Preserve both RAM mounts. The lower-image tmpfs is read-only, while
		# all runtime writes stay in the separate overlay tmpfs.
		mkdir -p \
			/newroot/.volatoo/lower \
			/newroot/.volatoo/ram-lower \
			/newroot/.volatoo/writable
		mount --move /image /newroot/.volatoo/lower ||
			fatal root.move-lower "could not preserve the squashfs lower mount"
		mount --move /ramimage /newroot/.volatoo/ram-lower ||
			fatal root.move-ram-lower \
				"could not preserve the RAM-backed lower image"
		mount --move /overlay /newroot/.volatoo/writable ||
			fatal root.move-writable "could not preserve the overlay write mount"
		;;
esac
mkdir -p /newroot/dev /newroot/proc /newroot/sys
mount --move /proc /newroot/proc ||
	fatal root.move-proc "could not move /proc into the new root"
mount --move /sys /newroot/sys ||
	fatal root.move-sys "could not move /sys into the new root"
mount --move /dev /newroot/dev ||
	fatal root.move-dev "could not move /dev into the new root"

echo "[volatoo] switching to $root_mode root; init=$target_init"
# switch_root must replace PID 1; running it as a child is rejected by BusyBox.
# shellcheck disable=SC2093
if [ "$state_mounted" -eq 1 ]; then
	exec switch_root \
		/newroot /usr/libexec/volatoo-persist-early "$target_init"
fi
exec switch_root /newroot "$target_init"
